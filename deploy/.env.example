# Render to /opt/linktrend/runtime/link-llm-council/prod.env.runtime on linkdroplet-00 (GSM).

# OpenRouter — required for live deliberation
OPENROUTER_API_KEY_SECRET_NAME=LINKTREND_AIOS_PROD_OPENROUTER_API_KEY

# Traefik (internal DNS on linkdroplet-00)
TRAEFIK_ROUTER_NAME=llm-council
TRAEFIK_HOST=llm-council.linktrend.internal
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_DOCKER_NETWORK=linktrend-network

# Optional model overrides (comma-separated OpenRouter ids)
# COUNCIL_MODELS=openai/gpt-5.1,google/gemini-3-pro-preview
# CHAIRMAN_MODEL=google/gemini-3-pro-preview
